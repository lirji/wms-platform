<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.wms.runtime.messaging.persistence.MessageQueueMetricsMapper">
    <!-- 仅接受运行Bean传入的封闭队列类别，不插值调用方表名。 -->
    <sql id="queueTable">
        <choose>
            <when test="queue == 'INBOX'">runtime_message_inbox</when>
            <when test="queue == 'INVENTORY_OUTBOX'">outbox_event</when>
            <when test="queue == 'FULFILLMENT_OUTBOX'">fulfillment_outbox</when>
            <otherwise>source_outbox</otherwise>
        </choose>
    </sql>
    <select id="boundedDepth" resultType="int" timeout="1">
        SELECT COUNT(*) FROM (SELECT 1 FROM <include refid="queueTable"/> WHERE status=#{status} LIMIT 1001) bounded_rows
    </select>
    <select id="oldestAgeMicros" resultType="long" timeout="1">
        SELECT TIMESTAMPDIFF(MICROSECOND, created_at, #{now}) FROM <include refid="queueTable"/>
        WHERE status=#{status} ORDER BY created_at LIMIT 1
    </select>
</mapper>
