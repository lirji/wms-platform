# 复制为仓库根目录 .env 后替换全部 change-me；.env 已被 gitignore。
# 仅本地隔离栈使用，不是生产密钥。docker compose 必填项用 :? 拒绝空值。
# 故障注入另起项目名与端口，例如 COMPOSE_PROJECT_NAME=wms-fault，禁止动共享 dev-infra。

WMS_BIND_ADDRESS=127.0.0.1
WMS_COMPOSE_SUBNET=10.89.40.0/24

WMS_MYSQL_APPS_HOST_PORT=18306
WMS_MYSQL_CELL_A_HOST_PORT=18307
WMS_MYSQL_CELL_B_HOST_PORT=18308
WMS_KAFKA_HOST_PORT=18992
WMS_KAFKA_ADVERTISED_HOST=localhost
WMS_REDIS_HOST_PORT=18379
WMS_SEATA_HOST_PORT=18091
WMS_SEATA_CONSOLE_HOST_PORT=17091
WMS_SEATA_ADVERTISED_IP=127.0.0.1
WMS_XXL_ADMIN_HOST_PORT=18080
WMS_CONSOLE_HOST_PORT=18180
WMS_INBOUND_HOST_PORT=18181
WMS_OUTBOUND_HOST_PORT=18182
WMS_INVENTORY_HOST_PORT=18183
WMS_SERIAL_HOST_PORT=18184
WMS_FULFILLMENT_HOST_PORT=18185

# 容器编译基础镜像（默认官方标签）。Docker Hub 不可达时可换成同标签镜像站。
# WMS_JDK_IMAGE=eclipse-temurin:21.0.8_9-jdk-jammy
# WMS_JRE_IMAGE=eclipse-temurin:21.0.8_9-jre-jammy
# WMS_NODE_IMAGE=node:22-alpine
# WMS_NGINX_IMAGE=nginx:1.27-alpine

WMS_MYSQL_APPS_ROOT_PASSWORD=change-me-apps-root
WMS_MYSQL_CELL_A_ROOT_PASSWORD=change-me-cell-a-root
WMS_MYSQL_CELL_B_ROOT_PASSWORD=change-me-cell-b-root
WMS_INBOUND_DB_PASSWORD=change-me-inbound
WMS_OUTBOUND_DB_PASSWORD=change-me-outbound
WMS_FULFILLMENT_DB_PASSWORD=change-me-fulfillment
WMS_SERIAL_DB_PASSWORD=change-me-serial-registry
WMS_SEATA_DB_PASSWORD=change-me-seata
WMS_XXL_DB_PASSWORD=change-me-xxl
WMS_INVENTORY_A_DB_PASSWORD=change-me-inventory-a
WMS_INVENTORY_B_DB_PASSWORD=change-me-inventory-b
WMS_REDIS_PASSWORD=change-me-redis
WMS_XXL_ACCESS_TOKEN=change-me-xxl-token

# OIDC：留空则业务接口全部拒绝，不会回退免认证。不要把密钥写进仓库。
# 浏览器与 JWT iss 用 localhost:8000；容器内拉 JWKS 用 host.docker.internal。
# WMS_OIDC_ISSUER=http://localhost:8000
# WMS_OIDC_JWK_SET_URI=http://host.docker.internal:8000/.well-known/jwks
# WMS_OIDC_CLIENT_ID=wms-platform
WMS_OIDC_ISSUER=
WMS_OIDC_JWK_SET_URI=
WMS_OIDC_CLIENT_ID=

# seed-local 必须显式提供，禁止默认 43306/dev-infra。隔离 compose 示例：
# WMS_INVENTORY_A_JDBC_URL=jdbc:mysql://127.0.0.1:18307/wms_inventory
# WMS_INVENTORY_A_DB_USER=wms_inventory_a
# WMS_INVENTORY_B_JDBC_URL=jdbc:mysql://127.0.0.1:18308/wms_inventory
# WMS_INVENTORY_B_DB_USER=wms_inventory_b
# WMS_INBOUND_JDBC_URL=jdbc:mysql://127.0.0.1:18306/wms_inbound
# WMS_INBOUND_DB_USER=wms_inbound
# WMS_OUTBOUND_JDBC_URL=jdbc:mysql://127.0.0.1:18306/wms_outbound
# WMS_OUTBOUND_DB_USER=wms_outbound
# WMS_FULFILLMENT_JDBC_URL=jdbc:mysql://127.0.0.1:18306/wms_fulfillment
# WMS_FULFILLMENT_DB_USER=wms_fulfillment
# 进程接库另用 WMS_INVENTORY_JDBC_URL / WMS_INVENTORY_DB_USER / WMS_INVENTORY_DB_PASSWORD

# 每实例运行预算，Spring ConfigurationProperties 环境变量按官方规则移除属性内连字符。
# 四个服务默认最大 16 个连接；共享数据库容量规划必须合计所有副本。
# WMS_RUNTIME_DB_MAXIMUMPOOLSIZE=16
# WMS_RUNTIME_DB_MINIMUMIDLE=2
# WMS_RUNTIME_DB_CONNECTIONTIMEOUTMS=1000
# WMS_RUNTIME_DB_STATEMENTTIMEOUTSECONDS=5
# WMS_RUNTIME_ADMISSION_GLOBALCONCURRENCY=64
# WMS_RUNTIME_ADMISSION_TENANTCONCURRENCY=16
# WMS_RUNTIME_ADMISSION_GLOBALREQUESTSPERSECOND=200
# WMS_RUNTIME_ADMISSION_TENANTREQUESTSPERSECOND=40
# 主数据展示最多陈旧 5 秒；Compose 已接本项目隔离 Redis。本机直启按需设置：
# WMS_RUNTIME_CACHE_REDISHOST=127.0.0.1
# WMS_RUNTIME_CACHE_REDISPORT=18379
# WMS_RUNTIME_CACHE_REDISPASSWORD=<由受控环境注入>
# WMS_RUNTIME_CACHE_REDISTLS=false
# WMS_RUNTIME_CACHE_NAMESPACE=wms:local:inventory:masterdata:v1:
# WMS_RUNTIME_CACHE_MAXAGEMS=5000
# WMS_RUNTIME_CACHE_ORIGINCONCURRENCY=4
# WMS_OUTBOX_BATCHSIZE=32
# WMS_OUTBOX_MAXCLAIMS=8
# WMS_OUTBOX_LEASESECONDS=30
# WMS_OUTBOX_BASEDELAYMS=1000
# WMS_OUTBOX_MAXDELAYMS=60000

# 当前两开关同时开启覆盖收货RECEIVE T1/T2/T3与库存投影；其他作业消息链仍待完成。
WMS_INBOUND_MESSAGING_ENABLED=false
WMS_INVENTORY_MESSAGING_ENABLED=false
WMS_MESSAGING_TOPIC_PREFIX=wms.local
# 本机进程启用时（Compose 使用容器内 kafka:9092）：
# WMS_MESSAGING_ENABLED=true
# WMS_MESSAGING_BOOTSTRAPSERVERS=127.0.0.1:18992
# WMS_MESSAGING_TOPICPREFIX=wms.local
# WMS_MESSAGING_SECURITYPROTOCOL=SASL_SSL
# WMS_MESSAGING_SASLMECHANISM=SCRAM-SHA-512
# WMS_MESSAGING_SASLJAASCONFIG=<受控环境注入，不写入仓库>

# 全部消息worker升级到支持retry_base_epoch后才启用，默认关闭人工恢复入口
WMS_MESSAGING_RECOVERYENABLED=false

# 必须与实际OIDC服务账户JWT subject一致，留空时登记服务拒绝启用数据库
WMS_SERIAL_ALLOWED_SUBJECTS=

# 物理库 DATETIME 瞬时字段：新库默认 UTC；旧库首次升级须核实历史偏移并填写审计依据。
# 不修改已有数据；禁止仅为通过启动填写未经核实的依据。JVM TZ 与仓库业务时区不决定此值。
WMS_RUNTIME_DB_TIME_STORAGE_ZONE=UTC
WMS_RUNTIME_DB_TIME_LEGACY_EVIDENCE=
# Compose 每个库独立配置；兼容固定偏移示例 +08:00，夏令时混合历史需独立转换。
WMS_INBOUND_STORAGE_ZONE=UTC
WMS_INBOUND_LEGACY_TIME_EVIDENCE=
WMS_OUTBOUND_STORAGE_ZONE=UTC
WMS_OUTBOUND_LEGACY_TIME_EVIDENCE=
WMS_INVENTORY_STORAGE_ZONE=UTC
WMS_INVENTORY_LEGACY_TIME_EVIDENCE=
WMS_SERIAL_STORAGE_ZONE=UTC
WMS_SERIAL_LEGACY_TIME_EVIDENCE=
WMS_FULFILLMENT_STORAGE_ZONE=UTC
WMS_FULFILLMENT_LEGACY_TIME_EVIDENCE=

# 库存到登记的服务JWT由外部凭据控制器挂载；详见SERIAL_REGISTRY_RUNTIME.md。
WMS_SERIAL_CLIENT_ENABLED=false
WMS_SERIAL_CLIENT_BASE_URL=
WMS_SERIAL_CLIENT_TOKEN_DIRECTORY=
WMS_SERIAL_CLIENT_ALLOW_HTTP=false

# 履约TC只读审计：先准备对应环境的证据表及SELECT专用账号，再按需启用。
# 应用不会安装TC触发器；详见FULFILLMENT_TC_RECOVERY.md，不代表生产部署授权。
WMS_TC_AUDIT_ENABLED=false
WMS_TC_CLUSTER_ID=
WMS_TC_TRANSACTION_GROUP=
WMS_TC_AUDIT_JDBC_URL=
WMS_TC_AUDIT_USER=
WMS_TC_AUDIT_PASSWORD=

# 库存确认到履约Inbox的消费者；与库存消息开关及对应Kafka Topic/ACL一起启用。
WMS_FULFILLMENT_MESSAGING_ENABLED=false

# 与库存消息开关同时启用，接通PICK/SHIP/CANCEL及其回执。
WMS_OUTBOUND_MESSAGING_ENABLED=false

# 原生RM默认关闭；启用前明确TC私网ACL、cell及数据库仓路由。
# TC通告地址可与NAT连接地址不同；实际运行值须从目标TC确认。
WMS_TCC_RM_ENABLED=false
WMS_TCC_RM_NETWORK_ISOLATION_CONFIRMED=false
WMS_TCC_RM_CELL_ID=
WMS_TCC_CLUSTER_ID=
WMS_TCC_TRANSACTION_GROUP=
WMS_TCC_SERVERS=
WMS_TCC_XID_ADDRESSES=
