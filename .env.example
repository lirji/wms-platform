# 复制为仓库根目录 .env 后替换全部 change-me；.env 已被 gitignore。
# 仅本地隔离栈使用，不是生产密钥。docker compose 必填项用 :? 拒绝空值。
# 故障注入另起项目名与端口，例如 COMPOSE_PROJECT_NAME=wms-fault，禁止动共享 dev-infra。

WMS_BIND_ADDRESS=127.0.0.1
WMS_COMPOSE_SUBNET=10.89.40.0/24

WMS_MYSQL_APPS_HOST_PORT=18306
WMS_MYSQL_CELL_A_HOST_PORT=18307
WMS_MYSQL_CELL_B_HOST_PORT=18308
WMS_KAFKA_HOST_PORT=18992
WMS_KAFKA_ADVERTISED_HOST=localhost
WMS_REDIS_HOST_PORT=18379
WMS_SEATA_HOST_PORT=18091
WMS_SEATA_CONSOLE_HOST_PORT=17091
WMS_SEATA_ADVERTISED_IP=127.0.0.1
WMS_XXL_ADMIN_HOST_PORT=18080

WMS_MYSQL_APPS_ROOT_PASSWORD=change-me-apps-root
WMS_MYSQL_CELL_A_ROOT_PASSWORD=change-me-cell-a-root
WMS_MYSQL_CELL_B_ROOT_PASSWORD=change-me-cell-b-root
WMS_INBOUND_DB_PASSWORD=change-me-inbound
WMS_OUTBOUND_DB_PASSWORD=change-me-outbound
WMS_SEATA_DB_PASSWORD=change-me-seata
WMS_XXL_DB_PASSWORD=change-me-xxl
WMS_INVENTORY_A_DB_PASSWORD=change-me-inventory-a
WMS_INVENTORY_B_DB_PASSWORD=change-me-inventory-b
WMS_REDIS_PASSWORD=change-me-redis
WMS_XXL_ACCESS_TOKEN=change-me-xxl-token
