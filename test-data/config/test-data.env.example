# 复制为 test-data/config/test-data.env 后按需覆盖。
# 密码不要写进仓库。优先使用仓库根目录 .env 中已有变量。
# 未设置 JDBC 时，脚本按 .env.example 的宿主端口拼隔离库连接串。

# WMS_BIND_ADDRESS=127.0.0.1
# WMS_MYSQL_APPS_HOST_PORT=18306
# WMS_MYSQL_CELL_A_HOST_PORT=18307
# WMS_MYSQL_CELL_B_HOST_PORT=18308

# WMS_INBOUND_DB_PASSWORD=
# WMS_OUTBOUND_DB_PASSWORD=
# WMS_FULFILLMENT_DB_PASSWORD=
# WMS_INVENTORY_A_DB_PASSWORD=
# WMS_INVENTORY_B_DB_PASSWORD=

# 可选：应用已启动且持有有效 JWT 时做业务 GET
# WMS_INBOUND_BASE_URL=http://127.0.0.1:18181
# WMS_OUTBOUND_BASE_URL=http://127.0.0.1:18182
# WMS_INVENTORY_BASE_URL=http://127.0.0.1:18183
# WMS_FULFILLMENT_BASE_URL=http://127.0.0.1:18185
# WMS_TEST_BEARER_TOKEN=
# WMS_TEST_WAREHOUSE_ID=WH-A
